# GoGermany — environment variables required for production.
# Copy to .env.local for local development; set these in Vercel
# (Project → Settings → Environment Variables) for prod + preview.
#
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser
# (and therefore to anyone who loads a page). Don't put secrets there.
# Everything else is server-only.

# ── Supabase ──────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Service-role key bypasses RLS — server-only. Used by admin server
# actions (articles / listings / jobs / unis CRUD, helpful vote,
# image upload, account delete, entitlements grants).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ── AI providers ──────────────────────────────────────────────────
# Anthropic — used by /api/cv-ai (Sonnet 4.6), /api/generate-anschreiben
# (Sonnet 4.6), /api/reading-exercise (Haiku 4.5), /api/writing-correction
# (Haiku 4.5), and scripts/generate_article_faqs.mjs.
ANTHROPIC_API_KEY=sk-ant-...

# Replicate — used by /api/enhance-photo (CV photo enhancement).
REPLICATE_API_TOKEN=r8_...

# ── Email (Resend) ────────────────────────────────────────────────
# Configured directly in Supabase → Authentication → SMTP Settings,
# not as an env var here. The Resend API key (re_...) lives there.
# This file is just a reminder that auth emails go through Resend.

# ── Admin panel ───────────────────────────────────────────────────
# Password for /console-x7k9 login. Pick a long random string;
# rotate periodically. Store in a password manager.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Optional: Supabase user_id used as the owner for admin-posted
# apartment listings. Leave empty to post with user_id=null.
ADMIN_LISTING_USER_ID=

# ── Public ─────────────────────────────────────────────────────────
# Calendly URL is optional — BookConsultationButton has a hardcoded
# fallback to the 5 per-tier event URLs. Leave empty in production.
NEXT_PUBLIC_CALENDLY_URL=

# NODE_ENV is set automatically by Vercel; do not override.
# NODE_ENV=production
